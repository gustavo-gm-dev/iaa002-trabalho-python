cols <- c("husage", "husunion", "husearns", "huseduc", "husblck",
"hushisp", "hushrs", "kidge6", "age", "black", "educ",
"hispanic", "union", "exper", "kidlt6")
X <- as.matrix(dados[, cols])
y <- dados$lwage
# Criando perfil para predição (valores do enunciado)
novo_perfil <- matrix(c(40, 0, 600, 13, 1, 0, 40, 1, 38, 0, 13, 1, 0, 18, 1),
nrow = 1, dimnames = list(NULL, cols))
# ============================================================
# PASSO 4: MODELO 1 - RIDGE (Alpha = 0)
# ============================================================
set.seed(42)
cv_ridge <- cv.glmnet(X, y, alpha = 0, nfolds = 10)
lambda_ridge <- cv_ridge$lambda.min
mod_ridge <- glmnet(X, y, alpha = 0, lambda = lambda_ridge)
pred_ridge <- predict(mod_ridge, s = lambda_ridge, newx = X)
rmse_ridge <- sqrt(mean((y - pred_ridge)^2))
r2_ridge   <- cor(y, pred_ridge)^2
# ============================================================
# PASSO 5: MODELO 2 - LASSO (Alpha = 1)
# ============================================================
set.seed(42)
cv_lasso <- cv.glmnet(X, y, alpha = 1, nfolds = 10)
lambda_lasso <- cv_lasso$lambda.min
mod_lasso <- glmnet(X, y, alpha = 1, lambda = lambda_lasso)
pred_lasso <- predict(mod_lasso, s = lambda_lasso, newx = X)
rmse_lasso <- sqrt(mean((y - pred_lasso)^2))
r2_lasso   <- cor(y, pred_lasso)^2
# ============================================================
# PASSO 6: MODELO 3 - ELASTICNET (Alpha entre 0 e 1)
# ============================================================
# Buscando o melhor Alpha para o ElasticNet
set.seed(42)
alphas <- seq(0.1, 0.9, by = 0.1)
best_alpha <- 0
min_cv_error <- Inf
for(a in alphas) {
cv_temp <- cv.glmnet(X, y, alpha = a, nfolds = 10)
if(min(cv_temp$cvm) < min_cv_error) {
min_cv_error <- min(cv_temp$cvm)
best_alpha <- a
cv_elastic <- cv_temp
}
}
lambda_elastic <- cv_elastic$lambda.min
mod_elastic <- glmnet(X, y, alpha = best_alpha, lambda = lambda_elastic)
pred_elastic <- predict(mod_elastic, s = lambda_elastic, newx = X)
rmse_elastic <- sqrt(mean((y - pred_elastic)^2))
r2_elastic   <- cor(y, pred_elastic)^2
# ============================================================
# PASSO 7: COMPARAÇÃO DOS MODELOS (Tabela Solicitada)
# ============================================================
tabela_metricas <- data.frame(
Modelo = c("Ridge", "Lasso", "ElasticNet"),
Alpha = c(0, 1, best_alpha),
Lambda = c(lambda_ridge, lambda_lasso, lambda_elastic),
RMSE = c(rmse_ridge, rmse_lasso, rmse_elastic),
R2 = c(r2_ridge, r2_lasso, r2_elastic)
)
cat("\n--- ESTATÍSTICAS DOS MODELOS ---\n")
print(tabela_metricas)
modelo_escolhido_alpha <- 1 # Troque para 0 se Ridge, ou 'best_alpha' se ElasticNet
modelo_escolhido_lambda <- lambda_lasso # Troque de acordo com o modelo
cat("\n--- PREDIÇÃO PARA NOVO PERFIL ---\n")
pred_log <- predict(mod_lasso, s = lambda_lasso, newx = novo_perfil)[1]
pred_dolar <- exp(pred_log) # Aplicando o antilog conforme exigido
cat("Predição (log):", round(pred_log, 5), "\n")
cat("Predição Salário-hora (US$):", round(pred_dolar, 4), "\n")
# Bootstrap (1000 reamostras) para Intervalo de Confiança
cat("\nCalculando Intervalo de Confiança (Pode levar alguns segundos)...\n")
set.seed(42)
B <- 1000
n <- nrow(X)
preds_boot <- numeric(B)
for(b in 1:B){
idx <- sample(1:n, n, replace = TRUE)
mod_b <- glmnet(X[idx, ], y[idx], alpha = modelo_escolhido_alpha, lambda = modelo_escolhido_lambda)
preds_boot[b] <- predict(mod_b, s = modelo_escolhido_lambda, newx = novo_perfil)[1]
}
ic <- quantile(preds_boot, c(0.025, 0.975))
cat("\n--- INTERVALO DE CONFIANÇA (95%) ---\n")
cat("IC 95% em log: [", round(ic[1], 5), ";", round(ic[2], 5), "]\n")
cat("IC 95% em US$/hora: [", round(exp(ic[1]), 2), ";", round(exp(ic[2]), 2), "]\n")
